<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name=".Context.MyApplication"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ex2Android"
        tools:targetApi="31">
        <activity
            android:name="com.Facybook_android.app.View.Feed.EditPost"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.Feed.CreateNewPost"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.Feed.comments"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.Feed.menu"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.Feed.Feed"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.SignUp.SignUp"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.Feed.UserPage"
            android:exported="false" />
        <activity
            android:name="com.Facybook_android.app.View.LogIn.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>